# Claude Code context exclusions
# Keeps large/generated/binary files out of Claude's context window

# Graphics — binary files, not useful as text
graphics/

# Data files — can be large, pull in manually when needed
data/

# Published HTML artifacts (generated by Quarto preview)
published/**/*.html
published/**/*_files/

# R environment artifacts
.Rproj.user/
.Rhistory
.RData
*.RDataTmp

# Secrets
.env
.httr-oauth
.secrets/

# OS artifacts
.DS_Store
